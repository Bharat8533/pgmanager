{
  "name": "pgmaster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"const f=require('fs');const c=f.realpathSync.native(process.cwd());process.chdir(c);require('child_process').execSync('next dev', {stdio:'inherit', cwd:c})\"",
    "build": "node -e \"const f=require('fs');const c=f.realpathSync.native(process.cwd());process.chdir(c);require('child_process').execSync('next build', {stdio:'inherit', cwd:c})\"",
    "start": "node -e \"const f=require('fs');const c=f.realpathSync.native(process.cwd());process.chdir(c);require('child_process').execSync('next start', {stdio:'inherit', cwd:c})\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
